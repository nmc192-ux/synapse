SYNAPSE_LOCAL_LOG_DIR=${HOME}/synapse-logs
SYNAPSE_LOCAL_RUNTIME_DIR=${HOME}/synapse-runtime
SYNAPSE_LOCAL_DATA_DIR=${HOME}/synapse-data
SYNAPSE_SUPERVISION_LOG_DIR=${HOME}/synapse-logs/services
SYNAPSE_BACKEND_ENV_FILE=.env.local.dev
SYNAPSE_UI_ENV_FILE=ui/.env.local
SYNTHETIC_ALPHA_SWARM_ENV_FILE=examples/synthetic_alpha_swarm/.env.synthetic-alpha
SYNTHETIC_ALPHA_SWARM_ENABLE=true
SYNAPSE_BACKEND_PORT=8000
SYNAPSE_UI_PORT=3001
SYNAPSE_UI_MODE=production
OPENCLAW_PROFILE=default_local
OPENCLAW_GATEWAY_PORT=18790
OPENCLAW_OLLAMA_API_KEY=ollama-local
SWARM_DIRECTOR_INTERVAL=300
SWARM_BROWSER_RUNNER_1_INTERVAL=180
SWARM_BROWSER_RUNNER_2_INTERVAL=180
SWARM_AUDITOR_INTERVAL=900
SWARM_REPORTER_INTERVAL=3600
SWARM_CHAOS_MONKEY_INTERVAL=86400
